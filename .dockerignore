# Never bake local configuration or credentials into the image.
env.*
!env.example
.env
.env.*
*.pem
*.key

# Git state, virtualenvs, caches, agent scratch space.
.git
.gitignore
.venv
venv
__pycache__
*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
htmlcov
.DS_Store
.context

# Local runtime data and exports.
*.db
*.db-*
*.sqlite*
*.log
logs
recordings
exports
.local
