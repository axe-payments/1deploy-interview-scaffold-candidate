# Planned application settings. This repository currently contains a handoff plan only.
# Copy with: cp env.example env.local
# env.local is private and untracked. Never paste credentials into this example.
APP_PORT=8000
ADMINER_PORT=8080
LOG_LEVEL=INFO

# Local interview database only. Set a local development password in env.local.
POSTGRES_DB=interview
POSTGRES_USER=interview
POSTGRES_PASSWORD=

# Optional integrations: leave blank until explicitly testing them.
# The incoming webhook fixes the destination Slack channel.
SLACK_WEBHOOK_URL=
NGROK_AUTHTOKEN=
# Optional public application URL override; normally discovered from the tunnel.
PUBLIC_BASE_URL=
