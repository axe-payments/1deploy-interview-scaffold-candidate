# Copy this file to env.local and fill in the values you were sent:
#   cp env.example env.local
# env.local is private and untracked. Never paste credentials into this example.
# Every docker compose command needs `--env-file env.local` (the scripts add it).

APP_PORT=8000
ADMINER_PORT=8080
LOG_LEVEL=INFO

# Local interview database only. POSTGRES_PASSWORD must be set (any local value).
POSTGRES_DB=interview
POSTGRES_USER=interview
POSTGRES_PASSWORD=interview
# Inside Docker the database host is the Compose service name. Only change these if
# you run the app outside Docker (then use POSTGRES_HOST=localhost and publish 5432).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Optional full connection URL override (e.g. sqlite://...). Leave blank normally.
DATABASE_URL=

# Optional integrations: leave blank until explicitly testing them. The app and
# database start fine without them.
# Slack incoming webhook. It fixes the destination channel; you get this from us.
SLACK_WEBHOOK_URL=
# Only needed for the ngrok tunnel option (the default cloudflared tunnel needs nothing).
NGROK_AUTHTOKEN=
# Optional public application URL override; normally discovered from the tunnel.
PUBLIC_BASE_URL=
